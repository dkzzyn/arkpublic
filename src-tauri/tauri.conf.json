{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ControleExped v1.2",
  "version": "1.2.0",
  "identifier": "com.controleexped.v12",
  "build": {
    "beforeDevCommand": "npm run frontend:start:tauri",
    "beforeBuildCommand": "npm run frontend:build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../frontend/build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ControleExped v1.2",
        "width": 1366,
        "height": 860,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 http://ipc.localhost ipc:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../backend"]
  }
}
